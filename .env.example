# Copy to .env and edit. Never commit .env.
# The defaults run the whole app offline with mock providers: no API keys needed.

# Providers: "mock" until Phase 6 adds real ones.
LLM_PROVIDER=mock
IMAGE_PROVIDER=mock

# Seconds the mock image provider pauses per image, so the live sheet build is visible. 0 = instant.
MOCK_DELAY_SECONDS=1.2

# Where the SQLite DB and generated images live. Default: api/storage
# STORAGE_DIR=C:/path/to/storage

# Default: sqlite file inside STORAGE_DIR. Postgres later, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/comickatha
# DATABASE_URL=

# Ports: the API runs on http://localhost:8010 (uv run uvicorn app.main:app --reload --port 8010)
# and the web dev server on http://localhost:5173. The web server proxies /api and /media here.
API_PROXY_TARGET=http://localhost:8010

# JSON list of web origins allowed to call the API directly.
CORS_ORIGINS=["http://localhost:5173"]

# Phase 6 (real providers). Leave empty until then.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
META_API_KEY=your-key-here
