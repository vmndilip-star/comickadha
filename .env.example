# Copy to .env and edit. Never commit .env.
# The defaults run the whole app offline with mock providers: no API keys needed.

# LLM: "mock" (offline builder helper, word-list safety) or "meta" (Meta's model API for the
# builder helper and the safety classifier; needs META_API_KEY and META_MODEL below).
LLM_PROVIDER=mock
# Images: "mock" until Phase 6 adds real ones.
IMAGE_PROVIDER=mock
# Character sheets: "builder" draws them from the avatar parts; "image" asks IMAGE_PROVIDER.
SHEET_PROVIDER=builder
# Seconds the builder pauses per cell, so the sheet visibly fills in (22 cells). 0 = instant.
BUILDER_REVEAL_SECONDS=0.08

# Seconds the mock image provider pauses per image, so the live sheet build is visible. 0 = instant.
MOCK_DELAY_SECONDS=1.2

# Where the SQLite DB and generated images live. Default: api/storage
# STORAGE_DIR=C:/path/to/storage

# Default: sqlite file inside STORAGE_DIR. Postgres later, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/comickatha
# DATABASE_URL=

# Ports: the API runs on http://localhost:8010 (uv run uvicorn app.main:app --reload --port 8010)
# and the web dev server on http://localhost:5173. The web server proxies /api and /media here.
API_PROXY_TARGET=http://localhost:8010

# JSON list of web origins allowed to call the API directly.
CORS_ORIGINS=["http://localhost:5173"]

# Phase 6 (real providers). Leave empty until then.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Meta's model API (OpenAI-compatible), used when LLM_PROVIDER=meta. Model names come from here,
# never from code. Models ending in -contributor are refused at startup (their requests may be
# used for training). META_VISION_MODEL defaults to META_MODEL.
META_API_KEY=your-key-here
META_MODEL=
META_VISION_MODEL=
META_BASE_URL=https://api.meta.ai/v1
META_TIMEOUT_SECONDS=20
